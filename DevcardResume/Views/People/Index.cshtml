@model IEnumerable<DevcardResume.Data.Models.People>

@{
    ViewData["Title"] = "Index";
}




<section class="about-me-section p-3 p-lg-5 theme-bg-light">
    <div class="container">
        <h2 class="heading font-weight-bold mb-3 text-capitalize text-center">Well Come to live Data Record Fetch</h2>

        <p>
            <a class="btn btn-success" asp-action="Create">Create New</a>
        </p>
        <div class="table-container shadow-lg">
            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.FirstName)</th>
                            <th>@Html.DisplayNameFor(model => model.LastName)</th>
                            <th>@Html.DisplayNameFor(model => model.City)</th>
                            <th>Commands</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class ="fw-bold text-dark">
                                    @Html.DisplayFor(modelItem => item.FirstName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.LastName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.City)
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.EncyptPID">Edit</a> |
                                    <a asp-action="Details" asp-route-id="@item.EncyptPID">Details</a> |
                                    <a asp-action="Delete" asp-route-id="@item.EncyptPID">Delete</a>
                                </td>
                            </tr>
                        }
                        <!-- Add remaining rows from the image as needed -->
                    </tbody>
                </table>
            </div>
        </div>
